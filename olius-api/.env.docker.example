# Copie para .env.docker. Exclusivo para docker run --env-file .env.docker.
# Valores literais, sem aspas. Não escapar barras invertidas nem cifrões.
# Exemplo fictício de senha literal: p\ass$parte
# Não importar no Spring como .properties nem passar ao Docker Compose.
CONTAINER_DEV_URL=jdbc:postgresql://host.docker.internal:5433/olius_dev
CONTAINER_DEV_USER=olius_core_api
CONTAINER_DEV_PASSWORD=
OLIUS_ALLOWED_ORIGINS=
