# Copie para .env.compose. Uso exclusivo com Docker Compose --env-file.
# Aspas simples preservam valores literais com $, sem interpolação.
# Não usar este arquivo no docker run --env-file nem no perfil local do Spring.
DOCKER_CORE_DB_URL=jdbc:postgresql://host.docker.internal:5433/olius_dev
CONTAINER_DEV_USER=olius_core_api
# Exemplo de sintaxe: CONTAINER_DEV_PASSWORD='segredo$parte'
CONTAINER_DEV_PASSWORD=
OLIUS_ALLOWED_ORIGINS=
