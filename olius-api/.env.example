# Copie para .env e preencha as senhas. Não versionar o .env.
# PostgreSQL local: estas credenciais inicializam um VOLUME NOVO.
# Não alteram usuários/senhas de um volume já existente.
CONTAINER_DEV_NAME=olius_dev
CONTAINER_DEV_ADMIN_USER=olius_dev_admin
CONTAINER_DEV_ADMIN_PASSWORD=

# Conexão da Core: usar conta limitada provisionada conforme access_control.
# Não usar a conta administrativa acima como datasource da API.
CONTAINER_DEV_URL=jdbc:postgresql://localhost:5433/olius_dev
CONTAINER_DEV_USER=olius_core_api
CONTAINER_DEV_PASSWORD=

# Segurança: estes valores mantêm os padrões fora do perfil local.
# No perfil local explícito, chaves temporárias, cookie HTTP e Swagger
# são configurados por application-local.properties.
OLIUS_JWT_EPHEMERAL_KEYS=false
OLIUS_JWT_PRIVATE_KEY_PATH=
OLIUS_JWT_PUBLIC_KEY_PATH=
OLIUS_COOKIE_SECURE=true
OLIUS_COOKIE_SAME_SITE=Strict
OLIUS_ALLOWED_ORIGINS=
OLIUS_API_DOCS_ENABLED=false
OLIUS_AUTH_REQUESTS_PER_MINUTE=60

# Produção: definir na hospedagem quando SPRING_PROFILES_ACTIVE=prod.
# O perfil prod não lê este arquivo automaticamente. Conta com privilégio limitado.
DB_URL=
DB_USER=
DB_PASSWORD=

# Selecionar no IntelliJ ou no ambiente de execução, NÃO dentro deste arquivo:
# SPRING_PROFILES_ACTIVE=local (desenvolvimento) ou prod (hospedagem).
# O .env só é importado depois que o perfil local já foi selecionado.
