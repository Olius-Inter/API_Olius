# Copie para .env e preencha as senhas. Não versionar o .env.
# Uso no perfil local do Spring e em docker run --env-file .env: valores sem aspas.
# Docker Compose da API: copie .env.compose.example para .env.compose e use
# --env-file .env.compose. Nesse arquivo exclusivo, use aspas simples em senhas
# com $, por exemplo CONTAINER_DEV_PASSWORD='segredo$parte'. Não use o arquivo
# com aspas no docker run nem no perfil local do Spring.
# PostgreSQL local: estas credenciais inicializam um VOLUME NOVO.
# Não alteram usuários/senhas de um volume já existente.
CONTAINER_DEV_NAME=olius_dev
CONTAINER_DEV_ADMIN_USER=olius_dev_admin
CONTAINER_DEV_ADMIN_PASSWORD=
# Configuração do OLIUS. Nunca versionar o .env; este exemplo não deve conter segredos reais.
# Selecione SPRING_PROFILES_ACTIVE=local ou prod na execução, não dentro deste arquivo.
# O perfil local importa o .env; produção recebe as variáveis pela hospedagem.
# Valores vazios não são equivalentes a variáveis ausentes. Preencher conforme o ambiente.



### Banco de produção ###
# O perfil prod recebe estas variáveis da hospedagem; não importa o .env local.

# URL JDBC do PostgreSQL de produção, com os parâmetros de conexão necessários.
DB_URL=

# Usuário de acesso limitado da Core ao banco de produção.
DB_USER=

# Senha do usuário da Core no banco de produção.
DB_PASSWORD=



### Banco de desenvolvimento — conexão da Core ###
# Selecionar o perfil local no IntelliJ ou no ambiente de execução.

# URL JDBC do PostgreSQL local; nome do banco deve corresponder a CONTAINER_DEV_NAME.
CONTAINER_DEV_URL=jdbc:postgresql://localhost:5433/olius_dev

# Nome do banco criado pelo Docker em um volume novo.
CONTAINER_DEV_NAME=olius_dev

# Usuário limitado da Core, provisionado conforme os scripts de acesso.
CONTAINER_DEV_USER=olius_core_api

# Senha do usuário limitado da Core no banco local.
CONTAINER_DEV_PASSWORD=

# Segurança: estes valores mantêm os padrões fora do perfil local.
# No perfil local explícito, chaves temporárias, cookie HTTP e Swagger
# são configurados por application-local.properties.


### Container de desenvolvimento — administração ###
# Estas variáveis inicializam um volume novo; não alteram senhas de volumes existentes. Não usar este usuário na Core.

# Usuário administrativo utilizado para inicializar o PostgreSQL do container.
CONTAINER_DEV_ADMIN_USER=olius_dev_admin

# Senha do usuário administrativo do container.
CONTAINER_DEV_ADMIN_PASSWORD=



### JWT — chaves de autenticação ###
# Os caminhos apontam para arquivos; não inserir o conteúdo das chaves nestas variáveis.

# Habilita chaves temporárias. O perfil local força true; prod força false.
OLIUS_JWT_EPHEMERAL_KEYS=false

# Caminho da chave privada RSA PKCS#8; obrigatório ao usar chaves persistentes.
OLIUS_JWT_PRIVATE_KEY_PATH=

# Caminho da chave pública RSA X.509 correspondente à chave privada.
OLIUS_JWT_PUBLIC_KEY_PATH=



### Navegador — cookies e CORS ###
# Configurações do acesso pelo frontend; CORS não substitui autenticação nem autorização.

# Restringe o cookie a HTTPS. O perfil local força false; prod força true.
OLIUS_COOKIE_SECURE=true

# Política SameSite do cookie de renovação; padrão Strict.
OLIUS_COOKIE_SAME_SITE=Strict

# Origens autorizadas do frontend, separadas por vírgula, sem caminho. Ex.: http://localhost:3000.
OLIUS_ALLOWED_ORIGINS=



### Documentação e limite de autenticação ###
# Os valores abaixo não concedem privilégios aos usuários.

# Habilita Swagger UI e OpenAPI. O perfil local já os habilita explicitamente.
OLIUS_API_DOCS_ENABLED=false

# Limite por IP e por instância para as operações abrangidas pelo filtro de autenticação; padrão 60.
OLIUS_AUTH_REQUESTS_PER_MINUTE=60



### Stripe — integração de pagamentos ###
# A integração atual exige credenciais de sandbox. Não usar chaves reais de produção nesta etapa.

# Habilita a integração Stripe; exige chaves, segredo do webhook e URLs de retorno válidos.
OLIUS_STRIPE_ENABLED=false

# Chave secreta de teste da Stripe, com prefixo sk_test_; nunca versionar.
STRIPE_SECRET_KEY=

# Segredo whsec_ para validar assinaturas do webhook; usar o segredo do destino correspondente.
STRIPE_WEBHOOK_SECRET=



### Checkout — páginas de retorno e validade ###
# As URLs pertencem ao frontend. Voltar à página de sucesso não confirma o pagamento na Core.

# URL da página após pagamento; obrigatória com Stripe habilitada.
OLIUS_CHECKOUT_SUCCESS_URL=

# URL da página para retornar sem concluir o pagamento; obrigatória com Stripe habilitada.
OLIUS_CHECKOUT_CANCEL_URL=

# Validade configurada do Checkout da contratação inicial; padrão 1h.
OLIUS_INITIAL_CHECKOUT_TTL=1h

# Validade configurada do Checkout de renovação manual; padrão 1h.
OLIUS_RENEWAL_CHECKOUT_TTL=1h

# Validade configurada do upgrade: maior que 35min e até 1h, limitada também ao fim do ciclo.
OLIUS_UPGRADE_CHECKOUT_TTL=1h



### Gmail — servidor SMTP ###
# Conexão com autenticação e STARTTLS obrigatório; não habilitar logs com credenciais ou mensagens.

# Servidor SMTP de envio; padrão smtp.gmail.com.
OLIUS_MAIL_HOST=smtp.gmail.com

# Porta SMTP com STARTTLS; padrão 587.
OLIUS_MAIL_PORT=587

# Endereço completo da conta Gmail utilizada para enviar convites e recuperações de senha.
OLIUS_MAIL_USERNAME=

# Senha de app do Google, nunca a senha normal da conta; nunca versionar.
OLIUS_MAIL_PASSWORD=

# Remetente das mensagens; inicialmente, o mesmo endereço autenticado acima.
OLIUS_MAIL_FROM=



### Convites administrativos — habilitação e aceite ###
# Habilitar somente após configurar o SMTP e a página de aceite conectada à Core.

# Habilita o envio dos convites por e-mail; padrão false. Configuração incompleta com true impede a inicialização.
OLIUS_ADMIN_INVITATION_EMAIL_ENABLED=false

# URL da página pública de aceite, não do endpoint da Core. Sem query ou fragmento; o envio acrescenta #token=<segredo>.
OLIUS_ADMIN_INVITATION_ACCEPTANCE_URL=


### Recuperação de senha ###
# Habilita endpoints operacionais e envio; exige SMTP e página configurados. Padrão false.
OLIUS_PASSWORD_RESET_ENABLED=false

# Página pública para escolher a nova senha, sem query/fragmento; link acrescenta #token=<segredo>.
OLIUS_PASSWORD_RESET_URL=

# Validade do token persistido; padrão 30 minutos. Formato Spring Duration.
OLIUS_PASSWORD_RESET_TTL=30m
